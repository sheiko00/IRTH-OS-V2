# ─── Database ────────────────────────────────────
DATABASE_URL=

# ─── Redis ───────────────────────────────────────
REDIS_URL=

# ─── JWT ─────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── App ─────────────────────────────────────────
APP_URL=
API_URL=
NODE_ENV=production
PORT=3001

# ─── Shipping ────────────────────────────────────
SHIPPING_PROVIDER=mock

# ─── Google Cloud Storage ────────────────────────
GCS_PROJECT_ID=
GCS_BUCKET=irth-os-assets
GCS_KEY_FILE=

# ─── Email (SpaceMail SMTP) ─────────────────────
SMTP_HOST=smtp.spacemail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
