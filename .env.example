# ============================================
# IRTH OS — Environment Variables
# ============================================
# Copy to .env and fill in your values

# Database
DATABASE_URL=postgresql://irth:irth_pass@localhost:5432/irth_os

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Storage (Google Cloud Storage)
GCS_PROJECT_ID=
GCS_BUCKET_NAME=irth-files
GCS_KEY_FILE=

# Shipping (mock by default)
BOSTA_API_KEY=
ARAMEX_API_KEY=
SHIPPING_PROVIDER=mock

# Email
SENDGRID_API_KEY=
EMAIL_FROM=noreply@irth.app

# WhatsApp
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=

# App
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
NODE_ENV=development
PORT=3001
