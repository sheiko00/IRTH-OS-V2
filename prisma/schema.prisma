generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTH & USERS
// ============================================

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  password           String
  name               String
  avatar             String?
  isActive           Boolean  @default(true)
  hashedRefreshToken String?
  roleId             String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  role               Role                 @relation(fields: [roleId], references: [id])
  createdOrders      Order[]              @relation("OrderCreator")
  assignedOrders     Order[]              @relation("OrderAssignee")
  statusChanges      OrderStatusHistory[]
  authoredNotes      OrderNote[]
  uploadedAssets     Asset[]
  marketingCampaigns Campaign[]           @relation("CampaignOwner")
  notifications      Notification[]       @relation("UserNotifications")

  @@index([email])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // SUPER_ADMIN, ADMIN, STAFF
  displayName String   @default("")
  permissions String[]
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

// ============================================
// CUSTOMERS (Separate from admin users)
// ============================================

model Customer {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  isActive  Boolean  @default(true)
  hashedRefreshToken String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses     Address[]
  orders        Order[]
  cart          Cart?
  notifications Notification[] @relation("CustomerNotifications")

  @@index([email])
}

model Address {
  id         String  @id @default(uuid())
  customerId String
  label      String  @default("Home")
  line1      String
  line2      String?
  city       String
  state      String?
  country    String  @default("EG")
  zipCode    String?
  isDefault  Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// ============================================
// PRODUCTS & CATEGORIES
// ============================================

model Category {
  id       String  @id @default(uuid())
  name     String
  nameAr   String?
  slug     String  @unique
  imageUrl String?
  sortOrder Int    @default(0)
  parentId String?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Product {
  id            String        @id @default(uuid())
  name          String
  nameAr        String?
  slug          String        @unique
  brand         String?
  categoryId    String?
  description   String?
  descriptionAr String?
  status        ProductStatus @default(DRAFT)
  basePrice     Float
  comparePrice  Float?
  cost          Float?
  currency      String        @default("EGP")
  tags          String[]
  coverImageUrl String?
  galleryUrls   String[]
  weight        Float?
  isFeatured    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category  Category?        @relation(fields: [categoryId], references: [id])
  variants  ProductVariant[]
  orderItems OrderItem[]
  campaigns CampaignProduct[]
  cartItems CartItem[]

  @@index([status])
  @@index([categoryId])
  @@index([slug])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  sku           String   @unique
  name          String?  // e.g. "Black / XL"
  attributes    Json     // {"color": "black", "size": "XL"}
  price         Float?   // Override base price
  cost          Float?
  stockQuantity Int      @default(0)
  barcode       String?
  weight        Float?
  imageUrl      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems       OrderItem[]
  cartItems        CartItem[]
  inventoryBatches InventoryBatch[]
  reorderAlert     ReorderAlert?

  @@index([productId])
}

// ============================================
// CART
// ============================================

model Cart {
  id         String     @id @default(uuid())
  customerId String?    @unique
  sessionId  String?    @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]
}

model CartItem {
  id        String @id @default(uuid())
  cartId    String
  productId String
  variantId String
  quantity  Int    @default(1)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

// ============================================
// ORDERS
// ============================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  IN_PRODUCTION
  READY
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  customerId      String?
  customerName    String
  customerPhone   String?
  customerEmail   String?
  shippingAddress String?
  shippingCity    String?
  shippingCountry String?
  paymentMethod   String?
  paymentStatus   String      @default("pending") // pending, paid, refunded
  subtotal        Float
  discount        Float       @default(0)
  shippingCost    Float       @default(0)
  tax             Float       @default(0)
  total           Float
  currency        String      @default("EGP")
  status          OrderStatus @default(PENDING)
  notes           String?
  isDeleted       Boolean     @default(false)
  createdById     String
  assignedToId    String?
  promoCodeId     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  customer      Customer?          @relation(fields: [customerId], references: [id])
  createdBy     User               @relation("OrderCreator", fields: [createdById], references: [id])
  assignedTo    User?              @relation("OrderAssignee", fields: [assignedToId], references: [id])
  promoCode     PromoCode?         @relation(fields: [promoCodeId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  orderNotes    OrderNote[]
  shipments     Shipment[]

  @@index([status, createdAt])
  @@index([isDeleted])
  @@index([customerId])
  @@index([orderNumber])
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  productId String
  variantId String
  quantity  Int
  price     Float
  total     Float

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])
  productionItems ProductionBatchItem[]
}

model OrderStatusHistory {
  id             String       @id @default(uuid())
  orderId        String
  status         OrderStatus
  previousStatus OrderStatus?
  changedById    String
  notes          String?
  createdAt      DateTime     @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User  @relation(fields: [changedById], references: [id])

  @@index([orderId])
}

model OrderNote {
  id        String   @id @default(uuid())
  orderId   String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])
}

// ============================================
// SUPPLIERS
// ============================================

enum SupplierStatus {
  PENDING
  APPROVED
  SUSPENDED
}

model Supplier {
  id        String         @id @default(uuid())
  name      String
  email     String         @unique
  password  String
  phone     String?
  company   String?
  country   String?
  status    SupplierStatus @default(PENDING)
  hashedRefreshToken String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  files           SupplierFile[]
  productionBatches ProductionBatch[]
  payouts         SupplierPayout[]

  @@index([status])
}

model SupplierFile {
  id         String   @id @default(uuid())
  supplierId String
  name       String
  fileUrl    String
  fileType   String   // COA, INVOICE, CERTIFICATE, TEST_REPORT
  fileSize   Int      @default(0)
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

// ============================================
// PRODUCTION
// ============================================

enum ProductionStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  QUALITY_CHECK
  COMPLETED
  CANCELLED
}

model ProductionBatch {
  id          String           @id @default(uuid())
  batchNumber String           @unique
  supplierId  String
  status      ProductionStatus @default(PENDING)
  cost        Float            @default(0)
  currency    String           @default("EGP")
  deadline    DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  supplier Supplier              @relation(fields: [supplierId], references: [id])
  items    ProductionBatchItem[]
  notes    ProductionNote[]
  expenses Expense[]

  @@index([status])
}

model ProductionBatchItem {
  id          String @id @default(uuid())
  batchId     String
  orderItemId String
  quantity    Int

  batch     ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  orderItem OrderItem       @relation(fields: [orderItemId], references: [id])
}

model ProductionNote {
  id        String   @id @default(uuid())
  batchId   String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

// ============================================
// INVENTORY
// ============================================

model InventoryBatch {
  id          String    @id @default(uuid())
  variantId   String
  batchNumber String    @unique
  quantity    Int
  remaining   Int
  expiryDate  DateTime?
  costPerUnit Float?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([expiryDate])
  @@index([variantId])
}

model ReorderAlert {
  id          String  @id @default(uuid())
  variantId   String  @unique
  minStock    Int     @default(10)
  isTriggered Boolean @default(false)
  lastAlertAt DateTime?

  variant ProductVariant @relation(fields: [variantId], references: [id])
}

// ============================================
// SHIPPING
// ============================================

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED
}

enum ReturnReason {
  CUSTOMER_REJECTED
  WRONG_ADDRESS
  UNREACHABLE
  DAMAGED
  FAILED_DELIVERY
  OTHER
}

model Shipment {
  id                    String         @id @default(uuid())
  orderId               String
  trackingNumber        String         @unique
  carrier               String         // bosta, aramex, etc.
  status                ShipmentStatus @default(PENDING)
  returnReason          ReturnReason?
  shippingCost          Float          @default(0)
  currency              String         @default("EGP")
  estimatedDeliveryDate DateTime?
  actualDeliveryDate    DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  order  Order           @relation(fields: [orderId], references: [id])
  events ShipmentEvent[]
  expenses Expense[]

  @@index([status])
  @@index([orderId])
}

model ShipmentEvent {
  id         String         @id @default(uuid())
  shipmentId String
  status     ShipmentStatus
  location   String?
  notes      String?
  createdAt  DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

// ============================================
// FILES & ASSETS
// ============================================

enum AssetType {
  IMAGE
  VIDEO
  DOCUMENT
  ARCHIVE
}

model AssetFolder {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent     AssetFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  subFolders AssetFolder[] @relation("FolderHierarchy")
  assets     Asset[]
}

model Asset {
  id           String    @id @default(uuid())
  folderId     String?
  name         String
  fileUrl      String
  type         AssetType @default(IMAGE)
  mimeType     String?
  size         Int       @default(0)
  tags         String[]
  uploadedById String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  folder     AssetFolder?    @relation(fields: [folderId], references: [id])
  uploadedBy User            @relation(fields: [uploadedById], references: [id])
  campaigns  CampaignAsset[]

  @@index([folderId])
  @@index([type])
}

// ============================================
// MARKETING
// ============================================

enum MarketingChannel {
  META
  GOOGLE
  TIKTOK
  INFLUENCER
  EMAIL
  WHATSAPP
  AFFILIATE
  ORGANIC
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model Campaign {
  id        String           @id @default(uuid())
  name      String
  objective String?
  channel   MarketingChannel
  budget    Float            @default(0)
  spent     Float            @default(0)
  currency  String           @default("EGP")
  startDate DateTime?
  endDate   DateTime?
  status    CampaignStatus   @default(DRAFT)
  ownerId   String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  owner       User              @relation("CampaignOwner", fields: [ownerId], references: [id])
  kpi         CampaignKPI?
  promoCodes  PromoCode[]
  assets      CampaignAsset[]
  products    CampaignProduct[]
  expenses    Expense[]
  influencers Influencer[]

  @@index([status, channel])
}

model CampaignKPI {
  id          String   @id @default(uuid())
  campaignId  String   @unique
  impressions Int      @default(0)
  clicks      Int      @default(0)
  cpc         Float    @default(0)
  ctr         Float    @default(0)
  cpa         Float    @default(0)
  revenue     Float    @default(0)
  roas        Float    @default(0)
  updatedAt   DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model CampaignAsset {
  campaignId String
  assetId    String
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([campaignId, assetId])
}

model CampaignProduct {
  campaignId String
  productId  String
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([campaignId, productId])
}

enum PromoDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model PromoCode {
  id            String            @id @default(uuid())
  code          String            @unique
  discountType  PromoDiscountType
  discountValue Float
  minOrderValue Float?
  maxDiscount   Float?
  usageCount    Int               @default(0)
  usageLimit    Int?
  expiryDate    DateTime?
  campaignId    String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  campaign Campaign? @relation(fields: [campaignId], references: [id])
  orders   Order[]

  @@index([code])
}

model Influencer {
  id         String   @id @default(uuid())
  name       String
  handle     String
  platform   String   // instagram, tiktok, youtube
  followers  Int?
  email      String?
  phone      String?
  campaignId String?
  promoCode  String?
  commission Float    @default(0)
  revenue    Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@index([platform])
}

// ============================================
// FINANCE
// ============================================

enum ExpenseCategory {
  PRODUCT_COST
  SHIPPING
  MARKETING
  SALARY
  TOOL
  PACKAGING
  FREELANCER
  OTHER
}

enum ExpenseStatus {
  PENDING
  PAID
  CANCELLED
}

model Expense {
  id                String          @id @default(uuid())
  title             String
  amount            Float
  currency          String          @default("EGP")
  category          ExpenseCategory
  status            ExpenseStatus   @default(PENDING)
  date              DateTime        @default(now())
  notes             String?
  productionBatchId String?
  shipmentId        String?
  campaignId        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  productionBatch ProductionBatch? @relation(fields: [productionBatchId], references: [id])
  shipment        Shipment?        @relation(fields: [shipmentId], references: [id])
  campaign        Campaign?        @relation(fields: [campaignId], references: [id])

  @@index([category, status])
  @@index([date])
}

model SupplierPayout {
  id         String        @id @default(uuid())
  supplierId String
  amount     Float
  currency   String        @default("EGP")
  status     ExpenseStatus @default(PENDING)
  date       DateTime      @default(now())
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId, status])
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id         String   @id @default(uuid())
  userId     String?
  customerId String?
  type       String   // ORDER_STATUS, STOCK_ALERT, CAMPAIGN_UPDATE, SYSTEM
  title      String
  body       String
  data       Json?    // Additional metadata
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user     User?     @relation("UserNotifications", fields: [userId], references: [id])
  customer Customer? @relation("CustomerNotifications", fields: [customerId], references: [id])

  @@index([userId, isRead])
  @@index([customerId, isRead])
  @@index([createdAt])
}

// ============================================
// SETTINGS
// ============================================

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value Json
  group String @default("general") // general, shipping, payment, email

  @@index([group])
}
